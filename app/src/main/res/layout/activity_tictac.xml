<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    style="@style/bg">

    <TextView
        android:id="@+id/tictac_instructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Instrucciones del juego"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:textAlignment="center"/>

    <GridLayout
        android:id="@+id/tictac_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        style="@style/gridd"
        android:columnCount="3"
        android:rowCount="3">

        <TextView
            android:id="@+id/button1"
            style="@style/TicTacButton1"
            android:textSize="40dp"
            android:gravity="center"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/button2"
            style="@style/TicTacButton2"
            android:gravity="center"
            android:textSize="40dp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/button3"
            android:textSize="40dp"
            style="@style/TicTacButton3"
            android:gravity="center"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/button4"
            style="@style/TicTacButton4"
            android:textSize="40dp"
            android:gravity="center"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/button5"
            style="@style/TicTacButton5"
            android:gravity="center"
            android:textSize="40dp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/button6"
            style="@style/TicTacButton6"
            android:textSize="40dp"
            android:gravity="center"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/button7"
            style="@style/TicTacButton7"
            android:textSize="40dp"
            android:gravity="center"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/button8"
            style="@style/TicTacButton8"
            android:textSize="40dp"
            android:gravity="center"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/button9"
            style="@style/TicTacButton9"
            android:textSize="40dp"
            android:gravity="center"
            android:textColor="@color/black" />
    </GridLayout>

    <TextView
        android:id="@+id/question_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pregunta"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/answer_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/answer1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <RadioButton
            android:id="@+id/answer2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <RadioButton
            android:id="@+id/answer3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <RadioButton
            android:id="@+id/answer4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RadioGroup>

    <Button
        android:id="@+id/button_submit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Revisar"
        android:layout_marginTop="20dp"/>
</LinearLayout>
